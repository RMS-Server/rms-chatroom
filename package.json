{
  "name": "rms-discord",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "web:dev": "pnpm --filter @rms-discord/web dev",
    "web:build": "pnpm --filter @rms-discord/web build",
    "desktop:dev": "pnpm -C apps/desktop exec tauri dev",
    "desktop:build": "pnpm -C apps/desktop exec tauri build",
    "desktop:build-frontend": "pnpm --filter @rms-discord/desktop build",
    "android:assemble-debug": "cd apps/android && ./gradlew assembleDebug",
    "android:assemble-release": "cd apps/android && ./gradlew assembleRelease",
    "test:ui-style": "node scripts/check-zhimo-theme.mjs"
  },
  "devDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.64.2",
    "@rollup/rollup-win32-x64-msvc": "4.64.2",
    "@tauri-apps/cli": "^2",
    "rollup": "^4.64.2",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "vue-draggable-plus": "^0.6.1"
  }
}
